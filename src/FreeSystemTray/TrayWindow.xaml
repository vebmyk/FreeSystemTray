<Window x:Class="FreeSystemTray.TrayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FreeSystemTray"
        xmlns:scaling="clr-namespace:FreeSystemTray.Scaling"
        Title="FreeSystemTray"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        UseLayoutRounding="True">
    <!-- The window is sized in code around ContentHost's measured size, so it can keep its anchor
         corner in place (SizeToContent would always keep the top-left corner).
         The window is per-pixel transparent (a layered window drawn by WPF) and the background is
         drawn by the content, so the show/hide animations only change the content: its opacity for
         a fade, its position for a slide (the window clips whatever moves outside it). WPF does not
         let a window without AllowsTransparency become layered, so it could not fade otherwise. -->
    <local:ContentSizeHost x:Name="ContentHost">
        <!-- All sizes come from TrayLayout (the scaling settings) through resources set in code. -->
        <Border Background="#FF2B2B2B" BorderBrush="#FF6A6A6A" BorderThickness="{DynamicResource TrayBorder}">
            <DockPanel>
                <Border x:Name="Grip"
                        DockPanel.Dock="Left"
                        Width="{DynamicResource GripWidth}"
                        Background="#FF4A4A4A"
                        Cursor="SizeAll"
                        MouseLeftButtonDown="Grip_MouseLeftButtonDown"
                        MouseMove="Grip_MouseMove"
                        MouseLeftButtonUp="Grip_MouseLeftButtonUp"
                        LostMouseCapture="Grip_LostMouseCapture">
                    <Border.ContextMenu>
                        <ContextMenu Opened="GripMenu_Opened" Closed="GripMenu_Closed">
                            <MenuItem x:Name="LockMenuItem" Header="_Lock position" IsCheckable="True" Click="LockMenuItem_Click" />
                            <MenuItem x:Name="SnapMenuItem" Header="_Snap to screen edges" IsCheckable="True" Click="SnapMenuItem_Click" />
                            <Separator />
                            <MenuItem x:Name="AutoHideMenuItem" Header="_Auto-hide" IsCheckable="True" Click="AutoHideMenuItem_Click" />
                            <MenuItem x:Name="HideMenuItem" Header="_Hide" Click="HideMenuItem_Click" />
                            <Separator />
                            <MenuItem Header="E_xit FreeSystemTray" Click="ExitMenuItem_Click" />
                        </ContextMenu>
                    </Border.ContextMenu>
                </Border>
                <ItemsControl x:Name="IconList" Margin="{DynamicResource IconListMargin}" MinWidth="{DynamicResource CellSize}" MinHeight="{DynamicResource CellSize}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Cell"
                                    Width="{DynamicResource CellSize}"
                                    Height="{DynamicResource CellSize}"
                                    Background="Transparent"
                                    ToolTip="{Binding ToolTip}"
                                    MouseEnter="Icon_MouseEnter"
                                    MouseLeave="Icon_MouseLeave"
                                    MouseMove="Icon_MouseMove"
                                    MouseDown="Icon_MouseDown"
                                    MouseUp="Icon_MouseUp">
                                <scaling:ScaledIcon Source="{Binding Image}"
                                                    IconId="{Binding Id}"
                                                    OwnerPath="{Binding OwnerPath}"
                                                    Width="{DynamicResource IconSize}"
                                                    Height="{DynamicResource IconSize}" />
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsHidden}" Value="True">
                                    <Setter TargetName="Cell" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <Trigger SourceName="Cell" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Cell" Property="Background" Value="#33FFFFFF" />
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>
    </local:ContentSizeHost>
</Window>
