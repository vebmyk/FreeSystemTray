<Window x:Class="FreeSystemTray.TrayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FreeSystemTray"
        Title="FreeSystemTray"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        UseLayoutRounding="True">
    <!-- The window is sized in code around ContentHost's measured size, so it can keep its anchor
         corner in place (SizeToContent would always keep the top-left corner).
         The window is per-pixel transparent (a layered window drawn by WPF) and the background is
         drawn by the content, so the show/hide animations only change the content: its opacity for
         a fade, its position for a slide (the window clips whatever moves outside it). WPF does not
         let a window without AllowsTransparency become layered, so it could not fade otherwise.
         Sizes come from TrayLayout (the scaling settings and the theme), colours from the theme,
         through resources set in code. The styles come first among the merged dictionaries, then the
         theme's values, then the theme's own XAML, which can override both. The hidden-icons flyout
         (OverflowWindow) shares these resources.
         The icon list shows the tray's icons (IconModel.Tray) and then the chevron that opens the
         flyout; their templates are in TrayStyles.xaml. -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theming/TrayStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <local:ContentSizeHost x:Name="ContentHost">
        <Border Background="{DynamicResource Tray.Background}"
                BorderBrush="{DynamicResource Tray.BorderBrush}"
                BorderThickness="{DynamicResource TrayBorder}"
                CornerRadius="{DynamicResource Tray.CornerRadius}">
            <DockPanel>
                <!-- Side and size are set in code from the theme's grip position. -->
                <Border x:Name="Grip"
                        DockPanel.Dock="Left"
                        Background="{DynamicResource Tray.GripBrush}"
                        CornerRadius="{DynamicResource Grip.CornerRadius}"
                        Cursor="SizeAll"
                        MouseLeftButtonDown="Grip_MouseLeftButtonDown"
                        MouseMove="Grip_MouseMove"
                        MouseLeftButtonUp="Grip_MouseLeftButtonUp"
                        LostMouseCapture="Grip_LostMouseCapture">
                    <Border.ContextMenu>
                        <ContextMenu Opened="GripMenu_Opened" Closed="GripMenu_Closed">
                            <MenuItem x:Name="LockMenuItem" Header="_Lock position" IsCheckable="True" Click="LockMenuItem_Click" />
                            <MenuItem x:Name="SnapMenuItem" Header="_Snap to screen edges" IsCheckable="True" Click="SnapMenuItem_Click" />
                            <Separator />
                            <MenuItem x:Name="AutoHideMenuItem" Header="_Auto-hide" IsCheckable="True" Click="AutoHideMenuItem_Click" />
                            <MenuItem x:Name="HideMenuItem" Header="_Hide" Click="HideMenuItem_Click" />
                            <Separator />
                            <MenuItem x:Name="ThemeMenuItem" Header="_Theme" />
                            <Separator />
                            <MenuItem Header="E_xit FreeSystemTray" Click="ExitMenuItem_Click" />
                        </ContextMenu>
                    </Border.ContextMenu>
                </Border>
                <ItemsControl x:Name="IconList" Margin="{DynamicResource IconListMargin}" MinWidth="{DynamicResource CellSize}" MinHeight="{DynamicResource CellSize}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <local:IconPanel Layout="{DynamicResource Icons.Layout}"
                                             Columns="{DynamicResource Icons.Columns}"
                                             Spacing="{DynamicResource Icons.Spacing}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </DockPanel>
        </Border>
    </local:ContentSizeHost>
</Window>
