<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>FreeSystemTray</RootNamespace>
    <StartupObject>FreeSystemTray.Program</StartupObject>
    <Version>0.1.0</Version>
    <!-- Drawn by tools/Make-AppIcon.ps1. -->
    <ApplicationIcon>FreeSystemTray.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Program.Main starts WPF itself, after checking for watchdog mode. -->
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <!-- The built-in themes: files next to the exe, read at run time. A theme's XAML is loose XAML
         (XamlReader), not compiled into the app. -->
    <Page Remove="Themes\**" />
    <Content Include="Themes\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- The settings window's icon. -->
    <Resource Include="FreeSystemTray.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FreeSystemTray.TrayHost\FreeSystemTray.TrayHost.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FreeSystemTray.Tests" />
  </ItemGroup>

</Project>
