<Window x:Class="TraySpike.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TraySpike"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        Background="#FF2B2B2B"
        UseLayoutRounding="True">
    <Border BorderBrush="#FF6A6A6A" BorderThickness="1">
        <DockPanel>
            <Border x:Name="Grip"
                    DockPanel.Dock="Left"
                    Width="10"
                    Background="#FF4A4A4A"
                    Cursor="SizeAll"
                    ToolTip="TraySpike: drag to move, right-click for menu"
                    MouseLeftButtonDown="Grip_MouseLeftButtonDown">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Exit TraySpike" Click="Exit_Click" />
                    </ContextMenu>
                </Border.ContextMenu>
            </Border>
            <ItemsControl x:Name="IconList" Margin="3,2" MinWidth="24" MinHeight="24">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Cell"
                                Width="{DynamicResource CellSize}"
                                Height="{DynamicResource CellSize}"
                                Background="Transparent"
                                ToolTip="{Binding ToolTip}"
                                MouseEnter="Icon_MouseEnter"
                                MouseLeave="Icon_MouseLeave"
                                MouseMove="Icon_MouseMove"
                                MouseDown="Icon_MouseDown"
                                MouseUp="Icon_MouseUp">
                            <Image Source="{Binding Image}"
                                   Width="{DynamicResource IconSize}"
                                   Height="{DynamicResource IconSize}"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsHidden}" Value="True">
                                <Setter TargetName="Cell" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <Trigger SourceName="Cell" Property="IsMouseOver" Value="True">
                                <Setter TargetName="Cell" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>
    </Border>
</Window>
